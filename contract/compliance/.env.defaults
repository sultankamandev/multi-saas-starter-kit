# Non-secret defaults for the compliance suite. Committed on purpose.
# Real environment variables override anything set here.

# The backend under test.
API_URL=http://localhost:8080

# Mail sink used by the email/2FA flow checks. Those 9 checks skip themselves
# when this is unreachable. `docker compose up` starts one at this address.
MAILPIT_URL=http://localhost:8025

# The 12 admin checks skip themselves unless these are set. Put them in a local
# .env (not committed) next to this file, after promoting an account:
#   ADMIN_EMAIL=you@example.com
#   ADMIN_PASSWORD=...
