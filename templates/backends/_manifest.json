{
  "templates": [
    {
      "id": "go-gin",
      "name": "Go (Gin + GORM)",
      "dir": "go-gin",
      "port": 8080,
      "language": "go",
      "variants": [],
      "status": "stable",
      "healthCheck": "/ping",
      "envFile": ".env.example",
      "installCmd": "go mod download",
      "devCmd": "go run ./cmd/server",
      "adminCmd": "go run ./cmd/admin",
      "adminDockerCmd": "./admin",
      "dockerfile": "go-api.Dockerfile",
      "dbUrlEnvFormat": "host=${DB_HOST} user=${DB_USER} password=${DB_PASS} dbname=${DB_NAME} port=${DB_PORT} sslmode=disable"
    },
    {
      "id": "python-fastapi",
      "name": "Python (FastAPI + SQLAlchemy)",
      "dir": "python-fastapi",
      "port": 8000,
      "language": "python",
      "variants": [],
      "status": "stable",
      "healthCheck": "/ping",
      "envFile": ".env.example",
      "installCmd": "pip install -r requirements.txt",
      "devCmd": "uvicorn app.main:app --reload",
      "adminCmd": "python -m app.cli promote",
      "adminDockerCmd": "python -m app.cli promote",
      "dockerfile": "python-api.Dockerfile",
      "dbUrlEnvFormat": "postgresql+asyncpg://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
    },
    {
      "id": "node-express",
      "name": "Node.js (Express + Drizzle)",
      "dir": "node-express",
      "port": 8080,
      "language": "typescript",
      "variants": [
        "ts"
      ],
      "status": "beta",
      "hint": "beta - passes compliance 34/34, like Go and Python",
      "limitations": [
        "Passes the full compliance suite 34/34 (core + email/2FA flows), at parity with Go and Python.",
        "Still beta pending broader real-world use; the schema is created by explicit DDL at boot (src/config/migrate.ts).",
        "Google login validates ID tokens over Google's tokeninfo endpoint (one network call per login) rather than cached JWKS."
      ],
      "healthCheck": "/ping",
      "envFile": ".env.example",
      "installCmd": "npm install",
      "devCmd": "npm run dev",
      "adminCmd": "npm run admin --",
      "adminDockerCmd": "node dist/scripts/admin.js",
      "dockerfile": "node-express.Dockerfile",
      "dbUrlEnvFormat": "postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
    }
  ]
}
