<%
  const fePort = frontend.prodPort || frontend.port;
  // Browsers omit the default port in the Origin header, so an origin of
  // "http://localhost:80" would never match and CORS would reject everything.
  const feOrigin = fePort === 80 ? 'http://localhost' : `http://localhost:${fePort}`;
-%>
services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: saas_app
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d saas_app"]
      interval: 5s
      timeout: 5s
      retries: 10

  # Development mail catcher. Every message the backend sends — email
  # verification, password reset, email 2FA codes — is captured here instead of
  # being delivered, and is readable in the web UI on port 8025. Replace this
  # with real SMTP credentials on the backend service before deploying.
  mailpit:
    image: axllent/mailpit:latest
    ports:
      - "1025:1025"
      - "8025:8025"
    environment:
      MP_SMTP_AUTH_ACCEPT_ANY: "1"
      MP_SMTP_AUTH_ALLOW_INSECURE: "1"

  backend:
    build:
      context: .
      dockerfile: docker/<%= backend.dockerfile %>
    ports:
      - "<%= backend.port %>:<%= backend.port %>"
    environment:
      PORT: "<%= backend.port %>"
<% if (backend.id === 'go-gin') { -%>
      DATABASE_URL: "host=postgres user=postgres password=postgres dbname=saas_app port=5432 sslmode=disable"
<% } else if (backend.id === 'python-fastapi') { -%>
      DATABASE_URL: "postgresql+asyncpg://postgres:postgres@postgres:5432/saas_app"
<% } else { -%>
      DATABASE_URL: "postgresql://postgres:postgres@postgres:5432/saas_app"
<% } -%>
      JWT_SECRET: "${JWT_SECRET:-dev-only-insecure-secret-replace-before-you-deploy}"
      FRONTEND_URL: "<%= feOrigin %>"
      CORS_ORIGINS: "<%= feOrigin %>"
      # Points at the mailpit service above. Unlike the frontend's API URL these
      # are resolved by the backend container, so the compose hostname is right.
      SMTP_HOST: "mailpit"
      SMTP_PORT: "1025"
      SMTP_FROM: "noreply@<%= projectName %>.local"
    depends_on:
      postgres:
        condition: service_healthy
      mailpit:
        condition: service_started

  frontend:
    build:
      context: .
      dockerfile: docker/<%= frontend.dockerfile %>
<% if (frontend.apiUrlEnv) { -%>
      # These are BUILD args, not runtime env: both Vite and Next.js inline
      # public env vars into the client bundle at build time. The value must be
      # reachable from the user's browser, so it is localhost — not the
      # "backend" compose hostname, which only resolves inside the network.
      args:
        <%= frontend.apiUrlEnv %>: "http://localhost:<%= backend.port %>"
        <%= frontend.apiUrlEnv.replace('API_URL', 'GOOGLE_CLIENT_ID') %>: "${<%= frontend.apiUrlEnv.replace('API_URL', 'GOOGLE_CLIENT_ID') %>:-}"
<% } -%>
    ports:
      - "<%= fePort %>:<%= fePort %>"
    depends_on:
      - backend

volumes:
  pgdata:
